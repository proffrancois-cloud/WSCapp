{
  "name": "wsc-alpaca-quiz",
  "version": "1.0.0",
  "private": true,
  "description": "A free unofficial World Scholar's Cup prep app with Challenge-style practice, Debate Lab, Alpacards, and a multiplayer study campus.",
  "main": "desktop/electron/main.js",
  "engines": {
    "node": "24.x",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "serve": "python3 -m http.server 4173",
    "build:pages": "node ../tools/deployment/prepare-github-pages.mjs --target=pages",
    "build:vercel": "node ../tools/deployment/prepare-github-pages.mjs --target=vercel",
    "audit:pages": "node ../tools/validators/audit-public-artifact.mjs dist-pages",
    "audit:vercel": "node ../tools/validators/audit-public-artifact.mjs dist-vercel",
    "verify": "npm run test:node-version && npm run test:classic-scripts && npm run test:auth-privacy && npm run test:campus2d && npm run test:theme && npm run test:css-imports && npm run test:desktop-config && npm run test:desktop-runtime && npm run test:pwa-mobile-shell && npm run test:pwa-retirement-runtime && npm run test:responsive-devices && npm run test:accessibility-scale && npm run test:mobile-keyboard && npm run test:device-visual && npm run test:mobile-webkit && npm run test:desktop-firefox && npm run test:device-runtime && npm run test:smoke && npm run build:pages && npm run audit:pages && npm run test:pwa-mobile-shell -- --artifact dist-pages && npm run test:pwa-retirement-runtime -- --artifact dist-pages && npm run test:responsive-devices -- --artifact dist-pages && npm run test:accessibility-scale -- --artifact dist-pages && npm run test:mobile-keyboard -- --artifact dist-pages && npm run test:device-visual -- --artifact dist-pages && npm run test:mobile-webkit -- --artifact dist-pages && npm run test:desktop-firefox -- --artifact dist-pages && npm run test:device-runtime -- --artifact dist-pages",
    "test:wscapp-live": "npm run test:responsive-devices -- --url=https://wscapp.app && npm run test:mobile-keyboard -- --url=https://wscapp.app && npm run test:device-visual -- --url=https://wscapp.app && npm run test:mobile-webkit -- --url=https://wscapp.app && npm run test:desktop-firefox -- --url=https://wscapp.app",
    "theme:extract": "node ../tools/generators/extract-current-2026-theme.mjs",
    "theme:build-question-bank": "node ../tools/generators/build-question-bank-from-theme.mjs ../content/themes/2026",
    "theme:validate": "node ../tools/validators/validate-theme.mjs ../content/themes/2026",
    "theme:build-runtime": "node ../tools/generators/build-current-runtime-from-theme.mjs ../content/themes/2026 generated/current-runtime",
    "theme:compare": "node ../tools/validators/compare-runtime-compat.mjs . generated/current-runtime --profile active-runtime",
    "theme:compare:strict": "node ../tools/validators/compare-runtime-compat.mjs . generated/current-runtime --profile strict",
    "theme:compare:legacy-audit": "node ../tools/validators/compare-runtime-compat.mjs . generated/current-runtime --profile legacy-audit",
    "theme:check-runtime": "node ../tools/validators/check-current-runtime-generated.mjs",
    "theme:refresh": "npm run theme:extract && npm run theme:build-question-bank && npm run theme:validate && npm run theme:build-runtime && npm run theme:compare",
    "test:node-version": "node ../tools/validators/validate-node-version.mjs",
    "test:app-js-budget": "node ../tools/validators/check-app-js-budget.mjs",
    "test:theme": "npm run theme:validate && npm run theme:compare && npm run theme:check-runtime",
    "verify:vercel": "npm run build:vercel && npm run audit:vercel",
    "test:classic-scripts": "node ../tools/validators/classic-script-dependency-map-test.mjs",
    "test:campus2d": "node ../tools/validators/campus-2d-world-test.mjs",
    "test:campus2d-debate": "node ../tools/validators/campus-2d-debate-lab-test.mjs",
    "test:campus2d-debate-audio": "node ../tools/validators/campus-2d-debate-audio-smoke.mjs",
    "test:smoke": "node ../tools/validators/smoke-test-app.mjs",
    "test:responsive-devices": "node ../tools/validators/responsive-device-smoke.mjs",
    "test:accessibility-scale": "node ../tools/validators/accessibility-scale-smoke.mjs",
    "test:mobile-keyboard": "node ../tools/validators/mobile-keyboard-smoke.mjs",
    "test:device-visual": "node ../tools/validators/device-visual-snapshot-smoke.mjs",
    "test:mobile-webkit": "node ../tools/validators/mobile-webkit-smoke.mjs",
    "test:desktop-firefox": "node ../tools/validators/desktop-firefox-smoke.mjs",
    "test:device-runtime": "node ../tools/validators/device-runtime-smoke.mjs",
    "test:auth-privacy": "node ../tools/validators/auth-privacy-test.mjs",
    "test:storage-failure": "node ../tools/validators/storage-failure-test.mjs",
    "test:headers": "node ../tools/validators/validate-vercel-headers.mjs",
    "test:html-boundary": "node ../tools/validators/html-boundary-test.mjs",
    "test:html-sinks": "node ../tools/validators/html-sink-guard.mjs",
    "test:desktop-config": "node ../tools/validators/electron-desktop-config-test.mjs",
    "test:desktop-runtime": "node ../tools/validators/electron-runtime-smoke.mjs",
    "test:pwa-mobile-shell": "node ../tools/validators/pwa-mobile-shell-test.mjs",
    "test:pwa-retirement-runtime": "node ../tools/validators/pwa-retirement-runtime-smoke.mjs",
    "test:css-imports": "node ../tools/validators/css-import-graph-test.mjs",
    "test:a11y-smoke": "playwright test e2e/modal-mobile.spec.ts",
    "desktop:dev": "electron .",
    "desktop:pack": "electron-builder --dir",
    "desktop:mac": "electron-builder --mac dmg zip",
    "desktop:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.1",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "org.worldscholarscup.study.routes",
    "productName": "WSCapp",
    "directories": {
      "buildResources": "desktop/icons",
      "output": "../builds/current"
    },
    "files": [
      "index.html",
      "styles.css",
      "styles-*.css",
      "app.js",
      "data.js",
      "knowledge-bank.js",
      "alpaca-channel.js",
      "raw-content-bank.js",
      "assets-config.js",
      "supabase-config.js",
      "manifest.webmanifest",
      "service-worker.js",
      "pwa.js",
      "src/**/*",
      "generated/**/*",
      "assets/**/*",
      "content/**/*",
      "app-icons/**/*",
      "desktop/electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "desktop/icons/app.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "desktop/icons/app.ico",
      "target": [
        "nsis",
        "portable"
      ]
    }
  }
}
